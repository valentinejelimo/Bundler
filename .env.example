# Copy to .env (gitignored) and fill in real keys.
# The CLI loads .env automatically via python-dotenv at startup.

# ── Required (default v18 spec uses both judges) ─────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
#   GOOGLE_API_KEY=...   # alternative env-var name accepted

# ── Optional (only if you re-wire judges to Anthropic) ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ──────────────────────────────────────────────────────
# GDPVAL_QC_CACHE_DIR=~/.cache/gdpval-qc   # document-conversion cache root
# GDPVAL_TEST_CORPUS=/path/to/full/corpus  # for `pytest tests/`
